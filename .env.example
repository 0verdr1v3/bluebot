# Copy to .env and adjust. Used by ./deploy.sh and the Makefile.

# How many Android panels to run.
PANELS=4

# redroid Android version (11.0.0, 12.0.0, 13.0.0 — see hub.docker.com/r/redroid/redroid/tags).
ANDROID_VERSION=11.0.0

# Host port for the web viewer.
VIEWER_PORT=8000

# Set to 1 if the host is already prepared (binder loaded) and you want to skip
# the sudo host-setup step in deploy.sh.
SKIP_HOST_SETUP=0
